# Keeps editors consistent with the formatters: Spotless (palantir-java-format) for backend Java and Prettier for the
# frontend. The formatters are the source of truth; see docs/CONVENTIONS.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[*.{xml,sql,py}]
indent_size = 4

[*.{ts,tsx,mts,js,mjs,css,json}]
max_line_length = 130

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
