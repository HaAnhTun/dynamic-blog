<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
    </parent>

    <groupId>com.blog</groupId>
    <artifactId>blog-backend</artifactId>
    <version>1.0.0-rc.1</version>
    <name>blog-backend</name>
    <description>Blog engine REST API</description>

    <properties>
        <java.version>25</java.version>
        <!-- Libraries that Spring Boot does NOT manage, so a Boot upgrade never moves them: BouncyCastle, springdoc, TwelveMonkeys,
             metadata-extractor (and ArchUnit in the test scope). The Dependabot maven entry proposes each one in a pull request of
             its own (.github/dependabot.yml), after a 7-day cooldown; Dependabot security updates skip the wait. The image parsers read
             untrusted uploads, so keep ImageProcessorTest and the media tests green when you bump them.
             TwelveMonkeys: one property for every module of the suite so they cannot drift apart. -->
        <twelvemonkeys.version>3.15.3</twelvemonkeys.version>
        <!-- Security overrides of the versions Boot 4.1.1 manages (docs/DEVELOPMENT.md, "CI"). Remove each one when the
             Boot patch manages a version at least this new; the Trivy scan of CI keeps them honest.
             tomcat: CVE-2026-65182, CVE-2026-65905, CVE-2026-68525 (fixed in 11.0.25; Boot 4.1.1 manages 11.0.24).
             jackson: denial-of-service advisories fixed in 2.21.7 and 3.1.7 (Boot 4.1.1 manages 2.21.5 and 3.1.5).
             postgresql: CVE-2026-54291, channelBinding downgrade (fixed in 42.7.12). -->
        <tomcat.version>11.0.27</tomcat.version>
        <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <postgresql.version>42.7.14</postgresql.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Reader GitHub login (oauth2Login). Since Boot 4 the starter is named spring-boot-starter-security-oauth2-*;
             the old name spring-boot-starter-oauth2-client is still in the 4.1 BOM but deprecated. No
             spring.security.oauth2.client.* property is set, so Boot's auto-config creates no ClientRegistrationRepository:
             GitHub login is enabled by the app's own configuration. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
        </dependency>
        <!-- Argon2PasswordEncoder calls org.bouncycastle.crypto.generators.Argon2BytesGenerator
             and ...crypto.params.Argon2Parameters, and BouncyCastle is NOT a transitive
             dependency of either starter above. Boot manages no bouncycastle.version, so the
             version is pinned here. Verified: 1.86 contains both classes. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>
        <!-- Newsletter: used only by SmtpMailTransport, and only when NEWSLETTER_TRANSPORT=smtp. Boot's JavaMailSender
             auto-config is excluded in application.yml: it builds a sender as soon as spring.mail.host is present. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!-- Not managed by Boot (see the properties). The Swagger UI webjar is in the jar but switched off in production: the paths
                 answer 404 unless the dev profile or SPRINGDOC_ENABLED turns them on (SpringDocExposureTest). -->
            <version>3.1.1</version>
        </dependency>
        <!-- Pure-Java ImageIO plugins, BSD-3-Clause. imageio-jpeg reads CMYK/YCCK JPEGs and broken ICC profiles that
             the JDK reader rejects, and converts the embedded profile to sRGB itself; imageio-webp adds a WebP
             READER that the JDK lacks (no writer: uploaded images are always re-encoded as JPEG/PNG). Pulls in
             imageio-core, imageio-metadata, common-lang/io/image (ResampleOp, so no separate downscaling
             library is needed). Tried on eclipse-temurin:25-jre-alpine in a 512 MB container. -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-jpeg</artifactId>
            <version>${twelvemonkeys.version}</version>
        </dependency>
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>${twelvemonkeys.version}</version>
        </dependency>
        <!-- Reads EXIF Orientation and DateTimeOriginal. Apache-2.0; pulls in com.adobe.xmp:xmpcore 6.1.11
             (BSD-3-Clause), whose XML parser rejects DOCTYPE and external entities, so XMP is not an XXE path. -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.21.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Build policy, checked in the validate phase of every build (CI, the Docker image, a developer's machine), together with
                 backend/.mvn/maven.config (the strict checksums option: a checksum mismatch fails the build instead of warning). The enforcer is
                 a Maven plugin of the build, not a dependency of the jar; its version is the one that Spring Boot manages. The rules: a Maven and a Java that are not older than the build needs, and no repository
                 but Maven Central, for dependencies and for plugins, so a pom (or a pom of a plugin) cannot add a second place that
                 artifacts come from. A mirror in your settings.xml counts as a repository: add its URL to the two allowed lists in your
                 own checkout, do not commit it. scripts/test_maven_policy.py holds the policy, and builds a scratch project to prove
                 that a foreign repository fails. Signature checks of the artifacts (pgpverify) are not used: docs/SECURITY.md. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-policy</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                                <bannedRepositories>
                                    <allowedRepositories>
                                        <allowedRepository>https://repo.maven.apache.org/maven2</allowedRepository>
                                    </allowedRepositories>
                                    <allowedPluginRepositories>
                                        <allowedPluginRepository>https://repo.maven.apache.org/maven2</allowedPluginRepository>
                                    </allowedPluginRepositories>
                                </bannedRepositories>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Declaring this list disables classpath-based processor discovery,
                         so any future annotation processor must be added here explicitly. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Same reason as the surefire argLine: PgJDBC sends the JVM's default
                         timezone to Postgres on connect, and postgres:18 rejects legacy tz
                         aliases such as "Asia/Saigon". Running the server in UTC also matches
                         how it runs in a container, where UTC is the default. -->
                    <jvmArguments>-Duser.timezone=UTC</jvmArguments>
                    <!-- Read by spring-boot:run (and start/test-run), not by repackage, so it never
                         reaches the jar: the dev profile turns Swagger UI and /v3/api-docs back on
                         (application-dev.yml). The jar, the Docker image and the E2E stack run without
                         a profile, so the API description stays off there. -->
                    <profiles>
                        <profile>dev</profile>
                    </profiles>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Postgres rejects legacy tz aliases like "Asia/Saigon" that PgJDBC
                         sends from the host JVM's default timezone; force UTC for tests. -->
                    <argLine>-Duser.timezone=UTC</argLine>
                    <!-- Surefire's defaults skip *IT classes (a Failsafe convention), which
                         would silently drop every Testcontainers-backed test from `mvn test`. -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.10.4</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/**/*.java</include>
                        </includes>
                        <!-- LF everywhere, matching .gitattributes and the formatter output. -->
                        <lineEndings>UNIX</lineEndings>
                        <palantirJavaFormat>
                            <version>2.102.0</version>
                        </palantirJavaFormat>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>14.3.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>config/checkstyle/checkstyle.xml</configLocation>
                    <suppressionsLocation>config/checkstyle/suppressions.xml</suppressionsLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <violationSeverity>error</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
