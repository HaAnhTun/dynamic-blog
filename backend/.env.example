DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog
DB_USERNAME=blog
DB_PASSWORD=blog
SERVER_PORT=8080

# Reader GitHub login (docs/CONFIGURATION.md, "GitHub login"). An empty client id or secret disables
# it; the backend still runs. OAuth App for this machine:
#   Homepage URL                 http://localhost:3000
#   Authorization callback URL   http://localhost:3000/api/auth/github/callback
# The secret goes only into backend/.env (git ignores that file), never into this file.
# Spring Boot does not read backend/.env by itself: export the keys below as environment variables
# before mvn spring-boot:run (docs/DEVELOPMENT.md has the syntax).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Origin of the frontend. With a client id and secret the backend builds the callback from it, and
# refuses to start if it is empty while GITHUB_REDIRECT_URI is also empty. It also decides whether
# the backend counts as a public site: any address other than localhost (or 127.x, ::1), including a
# LAN IP used to test on a phone, is production even with APP_ALLOW_DEV_DEFAULTS=true. The backend is
# fail-closed: JWT_SECRET, VIEWS_TOKEN, CLIENT_IP_TOKEN and the admin password must be real unless the dev profile
# (mvn spring-boot:run) or APP_ALLOW_DEV_DEFAULTS=true opts in (backend/README.md, "Production checks").
SITE_URL=http://localhost:3000
# Optional; empty means <SITE_URL>/api/auth/github/callback.
GITHUB_REDIRECT_URI=
# Optional. The numeric id of your GitHub account (https://api.github.com/users/<login>, field
# "id"): logging in to GitHub with that account yields the ADMIN role.
ADMIN_GITHUB_ID=

# Meilisearch search, optional (backend/README.md, "Search with Meilisearch"). All four empty means PostgreSQL, the default.
# postgres (empty) or meilisearch; set meilisearch only after a local Meilisearch is running and a reindex has been done.
SEARCH_ENGINE=
# http://127.0.0.1:7700 when a local Meilisearch is running; empty disables indexing.
MEILI_URL=
# Meilisearch and the backend both read this key; generate it with `openssl rand -base64 48`, write it only to backend/.env.
MEILI_MASTER_KEY=
# Empty means content_v1; must start with content_.
MEILI_INDEX_NAME=
