<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- A deliberately small rule set that the code already satisfies (zero baseline). Layout is the formatter's job
     (Spotless), so there are no whitespace or line-length rules here. New rules are added only once the code passes them. -->
<module name="Checker">
    <property name="severity" value="error"/>
    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}"/>
    </module>
    <property name="fileExtensions" value="java"/>

    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf"/>
    </module>

    <module name="TreeWalker">
        <!-- Output through a logger only; stack traces never go to the console. -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.|\.printStackTrace\(\)"/>
            <property name="message" value="Use the logger instead of System.out/err or printStackTrace"/>
            <property name="ignoreComments" value="true"/>
        </module>
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="ModifierOrder"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName">
            <!-- Test methods are descriptive snake_case sentences. -->
            <property name="format" value="^[a-zA-Z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="StaticVariableName"/>
        <module name="ConstantName">
            <property name="format" value="^(log|postgres|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="OneTopLevelClass"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
    </module>
</module>
