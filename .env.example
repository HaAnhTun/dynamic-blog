# Create .env with random secrets from this template:
#
#   ./scripts/init-env.sh            (Linux, macOS, Git Bash)
#   ./scripts/init-env.ps1           (Windows PowerShell)
#
# or copy it by hand (cp .env.example .env) and fill in every secret with a RANDOM value (init-env is the supported way). In
# production the backend refuses a secret that is guessable (a placeholder word, a repeated pattern, fewer than 6 different
# characters, a run like abcdefghij) and a VIEWS_TOKEN or CLIENT_IP_TOKEN shorter than 16 characters. docker-compose.yml refuses to start if any of the
# six required ones (DB_PASSWORD, JWT_SECRET, MFA_ENCRYPTION_KEY, SITE_URL, VIEWS_TOKEN, CLIENT_IP_TOKEN) is missing. With the three database roles below the postgres container also refuses to start, before it creates the data
# directory, unless the owner and administration credentials are all given and the three passwords differ, so a half-filled file fails
# immediately rather than deploying with a development default. A fresh install is claimed through /setup in the
# browser (docs/FIRST-RUN.md), so no admin password belongs in this file.
#
# .env is git-ignored. This file is not — keep real values out of it.

# ---------------------------------------------------------------- database
#
# Three PostgreSQL roles (docs/SECURITY.md, "Containers and networks"). The backend connects as the runtime role (DB_USERNAME), which
# reads and writes rows and nothing else. The migrations run as the owner role (DB_OWNER_USERNAME), which owns the schema. The
# administration role (DB_ADMIN_USERNAME) is the superuser of the container, for backups and repairs; the backend never uses it. The
# roles are made when the database directory is created. An install from before this has only DB_USERNAME and DB_PASSWORD (one
# superuser role) and keeps working as it is; leave the OWNER and ADMIN lines out for it, and see docs/UPGRADING.md to move it.

DB_NAME=blog
DB_USERNAME=blog_app
# Required. Postgres is not published outside the compose network, but this is still the
# credential that protects every post and every password hash.
DB_PASSWORD=
DB_OWNER_USERNAME=blog_owner
DB_OWNER_PASSWORD=
DB_ADMIN_USERNAME=blog_admin
DB_ADMIN_PASSWORD=

# ---------------------------------------------------------------- secrets

# Required. Signs the JWT access tokens. The development default is committed to this
# repository, so an instance still using it can have an ADMIN token minted by anyone who
# has read the source. At least 32 bytes — HS256 needs it and the application will refuse
# a shorter key. The backend has no default for it and refuses to start without a real value (fail-closed),
# including outside compose (Koyeb, Render), unless the dev profile or APP_ALLOW_DEV_DEFAULTS=true opts in.
#
#   openssl rand -base64 48
JWT_SECRET=

# Required. Encrypts the two-step verification (TOTP) secrets in the database (AES-256-GCM): exactly 32 random bytes as
# base64. The backend refuses to start without it, in every mode, and (outside an opted-in development run) with the
# development key committed to this repository or with the same value as JWT_SECRET. It is not derived from JWT_SECRET on
# purpose: rotating JWT_SECRET after a leak must not lock anybody out. A database backup does NOT contain it: keep a copy
# outside the server (a password manager). Changing it makes every enrolled account need the operator reset
# (docs/CONFIGURATION.md, "Changing MFA_ENCRYPTION_KEY").
#
#   openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# Optional. The proof of server access that an administrator without two-step verification enters once, at the forced
# enrollment after an upgrade (at least 24 characters). Empty means the backend generates a code into
# <SETUP_DATA_DIR>/mfa-enrollment-code and logs the path (read it with: docker compose exec backend cat /data/mfa-enrollment-code).
# Remove it from this file after the enrollment.
MFA_ENROLLMENT_TOKEN=
# Optional, one-off. Resets the two-step verification of the administrator with this email at startup (lost phone and lost
# recovery codes), once per distinct MFA_RESET_TOKEN (at least 24 characters). Remove both afterwards.
MFA_RESET_EMAIL=
MFA_RESET_TOKEN=

# Optional. How long a session of an ADMIN or AUTHOR account lives; readers are not affected. A session ends after
# PRIVILEGED_SESSION_IDLE_TTL without use (every refresh renews it) and, however active it was, PRIVILEGED_SESSION_ABSOLUTE_TTL after
# the person signed in; the shorter limit wins. A new session means a new second-step code for an account that has one. Values
# like 7d, 36h or PT12H; they must be longer than zero. Changing them applies to the sessions opened afterwards.
PRIVILEGED_SESSION_IDLE_TTL=7d
PRIVILEGED_SESSION_ABSOLUTE_TTL=30d

# Optional; leave it empty for a fresh install: you claim the instance at <SITE_URL>/setup with the setup code
# (docs/FIRST-RUN.md) and choose your own password there. When set, it is applied to the admin account at startup,
# hashed with Argon2id (the plaintext never reaches the database and is never logged), and /setup is closed because the
# instance is already claimed. Minimum 12 characters — the application refuses to start below that. With a public
# SITE_URL, the dev password admin12345 is always rejected, and the backend refuses to start if an existing admin
# account still has that password.
ADMIN_PASSWORD=
# Optional; empty means the backend generates a setup code and writes it to /data/setup-code in the backend container
# (read it with: docker compose exec backend cat /data/setup-code). If set, it is the setup code itself: at least
# 24 characters. Leave it empty unless you need a known code.
SETUP_TOKEN=

# Optional. The admin login email. If it differs from admin@blog.local, at startup the backend renames
# the existing admin account's email (admin@blog.local) to this value, provided no account already
# has it; ADMIN_PASSWORD is applied to that same account.
ADMIN_EMAIL=admin@blog.local

# ---------------------------------------------------------------- site

# Required. The public origin, with scheme and no trailing slash. It is baked into the
# client bundle at BUILD time, so changing it means rebuilding the frontend image, not
# just restarting it:
#
#   docker compose up -d --build
#
# Getting it wrong does not fail the build — it produces canonical URLs, Open Graph tags
# and a sitemap that all point at the wrong host.
#
# The backend also reads this value, at run time, to build the GitHub login callback:
# <SITE_URL>/api/auth/github/callback (the "GitHub login" section below). If you change it, change
# the callback in the OAuth App too. A non-loopback SITE_URL is production even when
# APP_ALLOW_DEV_DEFAULTS=true is set (the backend itself is production unless something opts in).
#
# With https, every Next response carries Strict-Transport-Security (HSTS_MAX_AGE below).
#
# Quick start on one machine: http://localhost:3000. For a public site use your https origin, for example
# https://example.com, and put a reverse proxy in front (deploy/Caddyfile.example, deploy/nginx.conf.example).
SITE_URL=http://localhost:3000

# The port and address on which compose publishes the frontend. Default 127.0.0.1:3000: only nginx on
# the same machine can reach it, and a reverse proxy handles TLS (docs/INSTALL.md, "Deploy to a VPS"). Session cookies
# carry the `secure` flag in production, so over plain HTTP the browser drops them and login silently
# has no effect.
#
# SITE_BIND=0.0.0.0 publishes on every interface; use it only when the reverse proxy is on another
# machine, and then firewall the port to the proxy machine alone. If Next receives requests straight
# from the internet (Docker opens the port with its own iptables rules, ufw does not block it), the
# client writes its own X-Forwarded-For, which is the key of every per-IP limit (GitHub login, admin
# login, view counting), and bypasses nginx's body-size limit.
#
# Upgrading from a version before V6: SITE_PORT is now just a port number. An old line
# SITE_PORT=127.0.0.1:3000 must become SITE_PORT=3000, otherwise compose reports a port error.
SITE_BIND=127.0.0.1
SITE_PORT=3000

# Optional; empty means 86400 (one day). The max-age of Strict-Transport-Security, sent only when
# SITE_URL is https. Baked into the image at build time: after changing it run `docker compose up -d --build`.
# Keep one day until HTTPS has proven stable (certificate auto-renews, every page opens over https), then
# raise it to 31536000 (one year): a wrong HSTS locks readers out of the site until max-age expires. 0 sends
# max-age=0, i.e. turns HSTS off: the browser forgets the remembered policy on its next visit over HTTPS.
HSTS_MAX_AGE=86400
# Optional; empty or false means no includeSubDomains. Set it to true only when you own every subdomain of your host and all
# of them are served over https (a subdomain without working HTTPS would go dark for the whole max-age). Baked in at build time
# like HSTS_MAX_AGE. There is no preload switch on purpose: it is almost impossible to undo.
HSTS_INCLUDE_SUBDOMAINS=false

# ---------------------------------------------------------------- images and views

# Optional; empty means 1GB. The total size of stored uploaded images (cover images, gallery), in Spring's
# DataSize syntax (400MB, 1GB). Images live in Postgres, not on disk, so this is the share of the database
# given to images; beyond it an upload returns 422 MEDIA_QUOTA_EXCEEDED. On the Neon free plan
# (~0.5 GB for the whole database) set it lower, for example 400MB.
MEDIA_MAX_TOTAL_SIZE=1GB

# ---------------------------------------------------------------- what an author may write

# Optional. The limits on an AUTHOR (never an ADMIN); empty means the default shown. A value below 1 stops the backend.
# docs/CONFIGURATION.md, "Author limits", explains each one.
# Tags on one post (400 VALIDATION_ERROR over it).
AUTHOR_MAX_TAGS_PER_POST=10
# Posts created in the last 24 hours, imports included (429 AUTHOR_QUOTA_EXCEEDED over it).
AUTHOR_MAX_POSTS_PER_DAY=30
# Images in the body of one post (422 AUTHOR_QUOTA_EXCEEDED over it).
AUTHOR_MAX_BODY_IMAGES_PER_POST=30
# Tags and categories in the whole catalog; above them only an administrator can create another (422 AUTHOR_QUOTA_EXCEEDED).
AUTHOR_MAX_TAGS=1000
AUTHOR_MAX_CATEGORIES=100
# Stored image bytes of one author (Spring's size syntax), and the percent of MEDIA_MAX_TOTAL_SIZE that all authors share
# (422 MEDIA_QUOTA_EXCEEDED over either).
AUTHOR_MEDIA_MAX_SIZE=100MB
AUTHOR_MEDIA_SHARE_PERCENT=50
# Old addresses (slugs) that an author's post keeps working after renames; the oldest are dropped.
AUTHOR_MAX_SLUG_HISTORY=5

# Optional; empty means Asia/Ho_Chi_Minh. The time zone that decides the day boundary of the view statistics (V7c).
# A standard IANA id; a wrong id makes the backend refuse to start. Changing it later does not move days already recorded.
ANALYTICS_TIME_ZONE=

# Required (since V6). A secret shared between the Next server and the backend for the view POST, an endpoint that
# writes without login (the V7c newsletter POSTs do not use this token). Compose passes the same value to both sides;
# outside compose (Koyeb, Render) set it identically on both: if they differ, every view becomes a silent 403.
# The backend logs a WARN at startup when this is empty while SITE_URL is a public URL.
#
#   openssl rand -hex 32
VIEWS_TOKEN=

# Required (since the per-address limits). A secret shared between the Next server and the backend that lets Next tell the
# backend which reader a request is for: Next sends the reader's address in X-Client-Ip and this secret in X-Client-Ip-Token on the
# calls that have a per-address limit at the backend (contact form, newsletter, admin sign-in, session refresh, first-run setup,
# search). The backend believes the address only when the secret matches, otherwise it counts the socket address, so someone who
# reaches the backend directly cannot choose their own limit key. Compose passes the same value to both sides; outside compose
# (Koyeb, Render) set it identically on both. If they differ, or the backend has none, every reader behind Next counts as ONE caller
# and the per-address limits trip for everybody. The backend refuses to start in production when it is empty.
#
#   openssl rand -hex 32
CLIENT_IP_TOKEN=

# ---------------------------------------------------------------- GitHub login (readers)

# Optional. If either one is empty it is off: the site still runs and readers can still see comments and
# likes, they just cannot log in to write. To enable it, create a SEPARATE OAuth App for production
# at https://github.com/settings/developers (OAuth Apps → New OAuth App):
#
#   Homepage URL                 https://example.com              (= SITE_URL)
#   Authorization callback URL   https://example.com/api/auth/github/callback
#
# The callback must be <SITE_URL>/api/auth/github/callback, character for character. The secret lives only
# in .env: never in this file, in git or in the docs.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional; empty is correct: the backend builds the callback from SITE_URL. If set, it must match the OAuth App's
# "Authorization callback URL" character for character, and be https.
GITHUB_REDIRECT_URI=

# Optional. The NUMERIC id (not the login) of the site owner's GitHub account: the "id" field at
# https://api.github.com/users/<login>. At startup the backend attaches it to the admin account,
# so that GitHub login yields the ADMIN role; if that id is already a reader, that reader is merged
# into the admin. Clearing the value does not unlink: docs/CONFIGURATION.md, "Link the admin account to GitHub".
ADMIN_GITHUB_ID=

# Optional; empty means 1. The number of your own proxies in front of Next: 1 for one reverse proxy as in
# deploy/. The per-IP limits (GitHub login, admin password login, views, contact ...) and the address forwarded to the backend
# read the IP at position N counting from the RIGHT of X-Forwarded-For, because the first entry is whatever the client sends
# itself. Behind Cloudflare keep 1 and let nginx restore the visitor address (set_real_ip_from and real_ip_header
# CF-Connecting-IP, docs/INSTALL.md, "Behind Cloudflare"); use 2 only if the origin accepts connections from Cloudflare alone,
# otherwise a caller who reaches the origin directly chooses its own key.
TRUSTED_PROXY_HOPS=1

# Optional; empty means 256. No effect while frontend/cache-handler.mjs is configured, which it is in the image and in `next start`:
# pages rendered on demand and the data cache then live in Next's in-memory LRU (cacheMaxMemorySize, 50 MB), which is what bounds a
# flood of made-up post addresses (a 404 is a page of about 250 KB), and nothing is written to disk. Only for a build without the handler:
# the most megabytes the pages Next renders on demand may take on disk, the oldest removed every 30 seconds. 0 means no limit.
ROUTE_CACHE_MAX_MB=256

# ---------------------------------------------------------------- newsletter

# Optional; empty means log: no mail is sent, only the mail type and id are written to the log. smtp: really sends via
# the provider below; the backend refuses to start when SITE_URL is not a public https URL,
# NEWSLETTER_FROM is invalid, SMTP_HOST is empty or NEWSLETTER_SECRET is shorter than 32 bytes.
NEWSLETTER_TRANSPORT=log
# The sender, for example: Blog <newsletter@example.com>. The domain must be verified with the provider
# (SPF, DKIM), otherwise mail lands in spam or is rejected.
NEWSLETTER_FROM=
# Required with smtp. The HMAC key of the unsubscribe link and of the block hash: set it ONCE before the first
# subscriber; changing it invalidates every unsubscribe link already sent and every block row.
#
#   openssl rand -base64 48
NEWSLETTER_SECRET=
# The provider's SMTP: port 587, STARTTLS required (or implicit TLS on port 465: SMTP_PROTOCOL=smtps and SMTP_PORT=465). The backend
# refuses SMTP_STARTTLS=false for a host that is not on this machine: the password and every mail would travel in clear text.
# The password lives only in .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_PROTOCOL=smtp

# ---------------------------------------------------------------- contact form

# Optional. The address that gets a mail copy of every contact form message (sent through the transport above, so it
# only really sends with NEWSLETTER_TRANSPORT=smtp). Empty: messages are only stored and read in /admin/contact.
# CONTACT_RECIPIENT=
# Optional; empty means 365. How many days a contact message is kept (a nightly job deletes older ones, read or not). 0 keeps every
# message until an administrator deletes it. docs/CONFIGURATION.md, "Contact form".
CONTACT_RETENTION_DAYS=365

# ---------------------------------------------------------------- memory

# Optional; empty means 768m. The memory limit of the backend container, in Docker syntax (768m,
# 1g). The Java heap is 70% of this number (MaxRAMPercentage=70 in backend/Dockerfile): 1g gives a
# maximum heap of 718 MiB, 768m gives 538 MiB. Uploaded images are decoded inside this heap, so lowering
# it makes large image uploads more likely to run out of memory. Minimum VPS RAM: 2 GB (docs/INSTALL.md).
BACKEND_MEM_LIMIT=768m

# ---------------------------------------------------------------- container images (optional)

# Optional; empty means the local-only names blog-engine-backend:local and blog-engine-frontend:local, which
# `docker compose up -d --build` builds from this checkout (a pull of them finds nothing, on purpose). To run the published backend
# image instead, set BACKEND_IMAGE to the registry namespace that publishes the release and pin a version tag or a digest, never a
# moving tag like latest (docs/INSTALL.md, "Prebuilt backend image or build from source"). There is no published frontend image: the
# site address, language and HSTS are compiled in when it is built, so the frontend is always built from this checkout.
# BACKEND_IMAGE=
# FRONTEND_IMAGE=
#
# Optional: start the frontend although SITE_URL is not the address its image was built for (it refuses by default; the fix is
# `docker compose up -d --build`).
# ALLOW_SITE_URL_MISMATCH=true

# ---------------------------------------------------------------- search (V8b, optional)

# postgres (default) or meilisearch; rolling back means setting postgres again, nothing else changes (docs/CONFIGURATION.md).
SEARCH_ENGINE=postgres
# Empty disables indexing; with `docker compose --profile search up -d` use http://meilisearch:7700.
MEILI_URL=
# Read only by the backend and the meilisearch service; scripts/init-env.* fill it with a random value. At least 32 characters: the backend rejects a shorter key on a public site.
MEILI_MASTER_KEY=
# The index being served, must start with content_ (the backend's search key only sees content_*).
MEILI_INDEX_NAME=content_v1

# Default locale of the public site, en or vi (build time for the frontend image; changing it means rebuilding). Its URLs have no /<locale> prefix.
# The backend reads the same variable: it is the language of posts created without one and, on the first start of a database that
# predates languages, of the existing posts and subscribers.
DEFAULT_LOCALE=en
