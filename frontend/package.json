    "hast-util-to-html": "9.0.5",
    "hast-util-to-jsx-runtime": "2.3.6",
    "hast-util-to-string": "3.0.1",
    "mermaid": "12.1.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
